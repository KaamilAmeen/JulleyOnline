# ---------------------------------------------------------------------------
# AI service environment. Copy to ai-service/.env and keep it out of git.
# ---------------------------------------------------------------------------
AI_SERVICE_TOKEN=change-me-to-match-backend-AI_SERVICE_TOKEN
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Answer mode
# ---------------------------------------------------------------------------
# Leave the key empty to use the deterministic, fully-local analyst (no network
# calls). Paste a Gemini key to let the model rephrase the tool results.
#
# Get a free key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25

# Any other OpenAI-compatible endpoint works too. Set LLM_PROVIDER=openai (or
# leave it out) and override these:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
