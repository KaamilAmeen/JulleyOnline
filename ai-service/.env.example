# ---------------------------------------------------------------------------
# AI service environment. Copy to ai-service/.env and keep it out of git.
# ---------------------------------------------------------------------------
AI_SERVICE_TOKEN=change-me-to-match-backend-AI_SERVICE_TOKEN
HOST=0.0.0.0
PORT=8000

# Optional: any OpenAI-compatible chat completions endpoint. Leave LLM_API_KEY
# empty to use the deterministic, fully-local analyst (no network calls).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=25
