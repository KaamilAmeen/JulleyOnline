# ---------------------------------------------------------------------------
# Backend environment — copy to backend/.env and fill in real values.
# NEVER commit .env (it is git-ignored).
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Local example:
#   postgresql://kanban_app:your_password@localhost:5432/collaborative_kanban?schema=public
DATABASE_URL="postgresql://kanban_app:CHANGE_ME@localhost:5432/collaborative_kanban?schema=public"

# API server
NODE_ENV=development
PORT=5000

# Secrets: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_ACCESS_SECRET="replace-with-a-random-32-byte-hex-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32-byte-hex-secret"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# COOKIE_DOMAIN=localhost

# Python AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-ai-service-token-change-me
