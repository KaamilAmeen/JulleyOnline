          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data[0]) {",
                  "  pm.collectionVariables.set('organizationId', body.data[0].id);",
                  "  if (body.data[0].tenants && body.data[0].tenants[0]) {",
                  "    pm.collectionVariables.set('tenantId', body.data[0].tenants[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/organizations", "host": ["{{baseUrl}}"], "path": ["organizations"] }
          }
        },
        {
          "name": "Create organization",
          "request": {
