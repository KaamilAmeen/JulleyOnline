            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Release Plan\",\n  \"description\": \"Q3 delivery board\",\n  \"templateColumns\": [\"Backlog\", \"In Progress\", \"Review\", \"Done\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/boards", "host": ["{{baseUrl}}"], "path": ["boards"] }
