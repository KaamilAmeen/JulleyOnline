{
  "info": {
    "_postman_id": "8f2b1d6e-4c7a-4f3b-9c1e-5a0d2b7e9f41",
    "name": "JulleyOnline Kanban API",
    "description": "Multi-tenant Kanban API. Run **Auth → Login** first: cookies are stored by Postman and tenantId is captured automatically. Then run any other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "tenantId", "value": "" },
    { "key": "organizationId", "value": "" },
    { "key": "boardId", "value": "" },
    { "key": "columnId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "membershipId", "value": "" },
    { "key": "email", "value": "rahul@abctech.dev" },
    { "key": "password", "value": "Password123!" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const memberships = body.data.memberships || [];",
                  "const tenantMembership = memberships.find((m) => m.tenantId) || memberships[0];",
                  "if (tenantMembership) {",
                  "  pm.collectionVariables.set('tenantId', tenantMembership.tenantId || tenantMembership.tenant.id);",
                  "  pm.collectionVariables.set('organizationId', tenantMembership.organizationId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Person\",\n  \"email\": \"new.person@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Organizations",
