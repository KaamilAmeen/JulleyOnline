{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "postgres": {
        "type": "local",
        "command": ["node", "scripts/postgres-mcp.mjs"],
        "cwd": ".",
        "timeout": {
          "startup": 20000,
          "catalog": 20000
        }
      }
    }
  }
}
