# ---------------------------------------------------------------------------
# JulleyOnline — environment reference
#
# Real values live in per-service files that are git-ignored:
#   backend/.env        (copy backend/.env.example)
#   frontend/.env.local (copy frontend/.env.local.example)
#   ai-service/.env     (copy ai-service/.env.example)
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
# Create the role/database first (see README) or point this at an existing DB.
DATABASE_URL="postgresql://kanban_app:CHANGE_ME@localhost:5432/collaborative_kanban?schema=public"

# --- Backend (Express, port 5000) -----------------------------------------
NODE_ENV=development
PORT=5000
JWT_ACCESS_SECRET="replace-with-64-hex-chars"
JWT_REFRESH_SECRET="replace-with-a-different-64-hex-chars"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN="shared-secret-between-node-and-python"

# --- Frontend (Next.js, port 3000) ----------------------------------------
# Server-side rewrite target for /api/*
BACKEND_URL=http://localhost:5000
# Socket.IO connects directly (WebSockets are not proxied by Next rewrites)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# --- AI service (FastAPI, port 8000) --------------------------------------
HOST=0.0.0.0
PORT=8000
# Optional: any OpenAI-compatible endpoint. Leave empty for the local,
# deterministic analyst (no outbound network calls).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=25
